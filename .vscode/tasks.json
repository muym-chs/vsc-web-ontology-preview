{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: compile",
      "type": "shell",
      "command": "bun",
      "args": [
        "run",
        "compile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "bun: watch-compile",
      "type": "shell",
      "command": "bun",
      "args": [
        "run",
        "watch"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        },
        "pattern": [
          {
            "regexp": "^([^\\s].*):(\\d+):(\\d+) - error TS(\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          }
        ]
      }
    }
  ]
}